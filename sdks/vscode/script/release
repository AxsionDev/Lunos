#!/usr/bin/env bash
set -euo pipefail

# Tags the next extension release (vscode-vX.Y.Z), which the publish-vscode workflow publishes.
# Reads and pushes tags on origin only: local clones can also hold upstream opencode's vscode-v*
# tags, and `git push --tags` would push all of them to Lunos (XCOD-122).

# Parse command line arguments
minor=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --minor) minor=true; shift 1;;
    *) echo "Unknown parameter: $1"; exit 1;;
  esac
done

latest_tag=$(git ls-remote --tags --refs origin 'vscode-v*' | sed 's|.*refs/tags/||' | grep -E '^vscode-v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1 || true)
if [ -z "$latest_tag" ]; then
    # First Lunos release of the extension: start from the CLI version it ships alongside.
    latest_tag="vscode-v$(node -p 'require("./package.json").version')"
    new_version="$latest_tag"
else
    echo "Latest tag: $latest_tag"

    # Split the tag into major, minor, and patch numbers
    IFS='.' read -ra VERSION <<< "$latest_tag"

    if [ "$minor" = true ]; then
        # Increment the minor version and reset patch to 0
        minor_number=${VERSION[1]}
        let "minor_number++"
        new_version="${VERSION[0]}.$minor_number.0"
    else
        # Increment the patch version
        patch_number=${VERSION[2]}
        let "patch_number++"
        new_version="${VERSION[0]}.${VERSION[1]}.$patch_number"
    fi
fi

echo "New version: $new_version"

# Tag
git tag "$new_version"
git push origin "$new_version"
